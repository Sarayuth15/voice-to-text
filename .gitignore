# Monitor Claude Token Usage - root .gitignore
# Covers both backend/ (Spring Boot/Maven) and frontend/ (Next.js) since
# this is a single repo with no monorepo tool tying them together.

# ---- dependencies ----
node_modules/

# ---- environment / secrets ----
# Never commit real secrets (DB creds, APP_ENCRYPTION_SECRET, etc).
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
!.env.example

# ---- frontend (Next.js) build output ----
frontend/.next/
frontend/out/
frontend/build/
frontend/next-env.d.ts
*.tsbuildinfo

# ---- backend (Maven/Spring Boot) build output ----
backend/target/

# ---- logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ---- OS files ----
.DS_Store
Thumbs.db

# ---- editor/IDE ----
.idea/
.vscode/
*.iml
.vercel

# ---- coverage/test output ----
coverage/
